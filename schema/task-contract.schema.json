{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskpack.org/schema/task-sync/1/task-contract.schema.json",
  "title": "Task Sync Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "task_id",
    "revision",
    "title",
    "objective",
    "scope",
    "definition_of_done",
    "constraints",
    "permissions",
    "deliverables",
    "next_steps",
    "open_questions"
  ],
  "properties": {
    "spec": { "const": "task-sync/1" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "$ref": "#/$defs/textList" },
        "exclude": { "$ref": "#/$defs/textList" }
      }
    },
    "definition_of_done": { "$ref": "#/$defs/nonEmptyTextList" },
    "constraints": { "$ref": "#/$defs/textList" },
    "permissions": { "$ref": "#/$defs/textList" },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "accept"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "accept": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_steps": { "$ref": "#/$defs/textList" },
    "open_questions": { "$ref": "#/$defs/textList" },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "ref"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "textList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "nonEmptyTextList": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
